{
  "name": "@contrail-spec/codex",
  "version": "0.2.0",
  "publishConfig": { "access": "public" },
  "description": "Contrail ↔ Codex CLI adapter — ask, log, and inject project memory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "contrail-codex": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "license": "Apache-2.0",
  "files": [ "dist" ],
  "dependencies": {
    "@contrail-spec/core": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}